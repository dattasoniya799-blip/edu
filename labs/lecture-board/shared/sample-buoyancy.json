    { "id": "k1_fig", "col": "c1", "kind": "figure", "figureId": "f_scene" },
    { "id": "k1_board", "col": "c1", "kind": "board", "title": "注水前:放在桌面上", "lines": [
      { "id": "l1a", "kind": "text", "text": "水平桌面上,压力等于重力" },
      { "id": "l1b", "kind": "formula", "tex": "F = G = mg = 0.48\\,\\text{kg} \\times 10\\,\\text{N/kg} = 4.8\\,\\text{N}", "speech": "压力等于重力,等于 m g,0.48 千克乘 10 牛每千克,等于 4.8 牛" },
      { "id": "l1c", "kind": "formula", "tex": "p = \\frac{F}{S} = \\frac{4.8\\,\\text{N}}{8\\times10^{-3}\\,\\text{m}^2} = 600\\,\\text{Pa}", "speech": "压强等于压力除以受力面积,4.8 牛除以 8 乘 10 的负 3 次方平方米,等于 600 帕" },
      { "id": "l1d", "kind": "conclusion", "text": "p = 600 Pa" }
    ] },

    { "id": "k2_anim", "col": "c2", "kind": "animation", "animationId": "a_buoy" },
    { "id": "k2_board", "col": "c2", "kind": "board", "title": "沉在水底:完全浸没", "lines": [
      { "id": "l2a", "kind": "text", "text": "沉入水底 → 完全浸没,V排 = V" },
      { "id": "l2b", "kind": "formula", "tex": "F_{浮} = \\rho_{水} g V_{排} = 1.0\\times10^{3}\\,\\text{kg/m}^3 \\times 10\\,\\text{N/kg} \\times 6\\times10^{-4}\\,\\text{m}^3", "speech": "浮力等于水的密度乘 g 乘排开液体的体积,1.0 乘 10 的 3 次方千克每立方米,乘 10 牛每千克,乘 6 乘 10 的负 4 次方立方米" },
      { "id": "l2c", "kind": "conclusion", "text": "F浮 = 6 N" }
    ] },
    { "id": "k2_table", "col": "c2", "kind": "table", "title": "浮沉判据", "markdown": "| 状态 | 比较 |\n|---|---|\n| 下沉 / 沉底 | G > F浮 |\n| 悬浮 | G = F浮 |\n| 上浮 / 漂浮 | G < F浮 |", "speech": "浮沉看重力和浮力谁大:重力大就下沉,相等就悬浮,浮力大就上浮。" },

    { "id": "k3_board", "col": "c3", "kind": "board", "title": "排水上浮 0.2 m", "lines": [
      { "id": "l3a", "kind": "text", "text": "顶部未露出水面 → V排 不变 → F浮 不变 = 6 N" },
